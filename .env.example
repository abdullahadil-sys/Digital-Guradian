# ==========================================================
# Digital Guardian - Backend Environment Variables
# Copy this file to ".env" and fill in the values you need.
# ==========================================================

# --- LLM Provider Selection ---
# One of: "anthropic", "openai", "none"
# If left as "none" (or if the matching API key below is missing),
# the backend automatically falls back to a rule-based / heuristic
# analysis engine so the application NEVER crashes or goes offline.
LLM_PROVIDER=none

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- OpenAI (alternative provider) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- App Settings ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_MESSAGE_LENGTH=4000
RETRIEVAL_TOP_K=4
